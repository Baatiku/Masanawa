# NON-RUNNABLE COMPOSE TEMPLATE. Save real values to /etc/masanawa/compose.env,
# and service settings separately to /etc/masanawa/runtime.env (both mode 0600).
# This sample is only for Compose schema validation in CI.
MASANAWA_RUNTIME_ENV_FILE=./runtime.env.example
POSTGRES_DB=masanawa
POSTGRES_USER=masanawa
POSTGRES_PASSWORD=CHANGE_ME_UNIQUE_LONG_PASSWORD
MASANAWA_GATEWAY_IMAGE=masanawa-gateway:pilot
MASANAWA_WORKER_IMAGE=masanawa-worker:pilot
MASANAWA_OPS_IMAGE=masanawa-ops:pilot
MASANAWA_GATEWAY_LOOPBACK_PORT=3100
MASANAWA_API_HOST=not-configured.invalid
