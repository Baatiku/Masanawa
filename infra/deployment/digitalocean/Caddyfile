{$MASANAWA_API_HOST} {$MASANAWA_API_ADDITIONAL_HOSTS} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
  @private path /auth/* /api/* /v1/* /billing/* /webhooks/*
  header @private Cache-Control "private, no-store"
  @ops path /v1/admin /v1/admin/* /v1/agents /v1/agents/* /v1/skills /v1/skills/*
  handle @ops {
    header Cache-Control no-store
    reverse_proxy ops:3002
  }
  handle {
    reverse_proxy gateway:3000
  }
}
