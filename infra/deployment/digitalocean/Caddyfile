{$MASANAWA_API_HOST} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
  @ops path /v1/admin /v1/admin/* /v1/agents /v1/agents/* /v1/skills /v1/skills/*
  handle @ops {
    header Cache-Control no-store
    reverse_proxy ops:3002
  }
  handle {
    reverse_proxy gateway:3000
  }
}
