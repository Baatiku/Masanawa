# NON-RUNNABLE SAMPLE. Production: /etc/masanawa/runtime.env mode 0600.
# API credentials/OTP keys only here; never in the Compose interpolation file.
# URI-encode PostgreSQL password if it contains URL-reserved characters.
MASANAWA_DATABASE_URL=postgres://masanawa:CHANGE_ME_UNIQUE_LONG_PASSWORD@postgres:5432/masanawa
MASANAWA_PUBLIC_BASE_URL=https://not-configured.invalid
MASANAWA_AUTH_PUBLIC_BASE_URL=https://not-configured.invalid
MASANAWA_PLATFORM_TENANT_ID=
MASANAWA_AUTH_OTP_PEPPER=
MASANAWA_WEB_ALLOWED_ORIGINS=https://not-configured.invalid
MASANAWA_PRODUCT_SCOPE=masana-lite
MASANAWA_GEMINI_API_KEY=
RESEND_API_KEY=
MASANAWA_AUTH_EMAIL_FROM=
# Explicitly inactive until independent provider/billing/worker qualification.
MASANAWA_ALPHA_ENABLED=false
MASANAWA_MB_REPLIES_ENABLED=false
MASANAWA_MB_CALLS_ENABLED=false
MASANAWA_NGN_CALLS_ENABLED=false
MASANAWA_BILLSTACK_LIVE_DEPOSITS_ENABLED=false
FLUTTERWAVE_BILLS_ENABLED=false
MASANAWA_GB_DATA_PURCHASE_ENABLED=false
MASANAWA_NGN_DATA_CATALOG_ENABLED=false
MASANAWA_NGN_DATA_PURCHASE_ENABLED=false
# MASANAWA_NGN_DATA_APPROVALS_JSON=<admin-reviewed array, server-only>
MASANAWA_NEWS_INGEST_ENABLED=false
MASANAWA_STATUS_PROMOTIONS_ENABLED=false
MASANAWA_STATUS_TIPS_ENABLED=false
