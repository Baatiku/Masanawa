<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="16.0dp" />
            <solid android:color="@color/osdk_always_color_dcdcdc" />
        </shape>
    </item>
    <item>
        <ripple android:color="?android:colorControlHighlight">
            <item>
                <shape>
                    <corners android:radius="16.0dp" />
                    <gradient android:startColor="@color/osdk_color_00B876" android:endColor="@color/osdk_color_26DAB9" android:angle="180.0" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
