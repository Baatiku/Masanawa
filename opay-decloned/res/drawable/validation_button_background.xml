<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:state_enabled="true" app:state_invalid="true">
        <ripple android:color="?android:colorControlHighlight">
            <item android:id="@android:id/mask">
                <shape>
                    <corners android:radius="30.0dp" />
                    <solid android:color="@color/osdk_color_black" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="30.0dp" />
                    <solid android:color="@color/red_pink" />
                </shape>
            </item>
        </ripple>
    </item>
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="30.0dp" />
            <solid android:color="@color/osdk_color_00B876_30" />
        </shape>
    </item>
    <item>
        <ripple android:color="?android:colorControlHighlight">
            <item android:id="@android:id/mask">
                <shape>
                    <corners android:radius="30.0dp" />
                    <solid android:color="@color/osdk_color_black" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="30.0dp" />
                    <solid android:color="@color/osdk_color_00B876" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
