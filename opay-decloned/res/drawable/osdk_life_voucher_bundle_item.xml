<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="?android:colorControlHighlight"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="12.0dp" />
            <solid android:color="@color/osdk_color_black" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <corners android:radius="12.0dp" />
                    <solid android:color="@color/osdk_1A7D4FFF" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape>
                    <corners android:radius="12.0dp" />
                    <stroke android:width="1.0dp" android:color="@color/primary" />
                    <solid android:color="@color/osdk_color_white" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="12.0dp" />
                    <solid android:color="@color/osdk_color_white" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
