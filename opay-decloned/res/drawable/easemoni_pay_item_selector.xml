<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/okash_dimen_8" />
                    <solid android:color="@color/easemoni_color_1a0055ff" />
                </shape>
            </item>
            <item>
                <bitmap android:gravity="end|bottom" android:src="@drawable/easemoni_ic_term_selected_bottom_end" />
            </item>
        </layer-list>
    </item>
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/okash_dimen_8" />
            <solid android:color="@color/easemoni_color_f8f8f8" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/okash_dimen_8" />
                    <solid android:color="@color/easemoni_color_1a0055ff" />
                </shape>
            </item>
            <item>
                <bitmap android:gravity="end|bottom" android:src="@drawable/easemoni_ic_term_selected_bottom_end" />
            </item>
        </layer-list>
    </item>
</selector>
