<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="?android:colorControlHighlight"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <corners android:radius="12.0dp" />
                    <solid android:color="@color/osdk_color_white" />
                    <stroke android:width="1.0dp" android:color="#ff00b876" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="12.0dp" />
                    <solid android:color="@color/osdk_color_white" />
                    <stroke android:width="1.0dp" android:color="#4d8497a4" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
