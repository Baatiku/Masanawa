<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="?android:colorControlHighlight"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="@dimen/button_corner_radius" />
            <solid android:color="@color/osdk_color_black" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true" app:state_invalid="false">
                <shape>
                    <solid android:color="@color/osdk_color_white" />
                    <corners android:radius="@dimen/button_corner_radius" />
                    <stroke android:width="1.0dp" android:color="@color/mint" />
                </shape>
            </item>
            <item android:state_selected="true" app:state_invalid="true">
                <shape>
                    <solid android:color="@color/osdk_color_white" />
                    <corners android:radius="@dimen/button_corner_radius" />
                    <stroke android:width="1.0dp" android:color="@color/red_pink" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/osdk_color_white" />
                    <corners android:radius="@dimen/button_corner_radius" />
                    <stroke android:width="1.0dp" android:color="@color/grey300" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
