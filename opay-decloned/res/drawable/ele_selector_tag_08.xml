<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/osdk_color_f0fbf7" />
                    <corners android:radius="8.0dp" />
                    <stroke android:width="1.0dp" android:color="@color/mint" />
                </shape>
            </item>
            <item>
                <bitmap android:gravity="right|bottom" android:src="@mipmap/tv_select_tag" />
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8.0dp" />
            <solid android:color="@color/osdk_color_white" />
        </shape>
    </item>
</selector>
