<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="12.0dp" />
            <solid android:color="@color/opb_green_light" />
            <stroke android:width="1.0dp" android:color="@color/mint" />
        </shape>
    </item>
    <item>
        <ripple android:color="?android:colorControlHighlight">
            <item>
                <shape>
                    <solid android:color="@color/opb_f8f8fb" />
                    <corners android:radius="12.0dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
