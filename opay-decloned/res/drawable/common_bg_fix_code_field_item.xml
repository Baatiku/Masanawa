<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false" android:state_activated="false">
        <shape>
            <stroke android:width="1.0dp" android:color="@color/opb_fix_code_stroke_color" />
            <corners android:radius="4.0dp" />
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <stroke android:width="1.0dp" android:color="@color/mint" />
            <corners android:radius="4.0dp" />
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <corners android:radius="4.0dp" />
            <stroke android:width="1.0dp" android:color="#ff2e62" />
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="1.0dp" android:color="@color/opb_fix_code_stroke_color" />
            <corners android:radius="4.0dp" />
            <solid android:color="@color/white" />
        </shape>
    </item>
</selector>
