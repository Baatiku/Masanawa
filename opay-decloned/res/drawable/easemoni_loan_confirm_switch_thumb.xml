<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="oval">
            <size android:height="21.0dp" android:width="21.0dp" />
            <solid android:color="@color/easemoni_color_white" />
            <stroke android:width="2.0dp" android:color="@color/easemoni_color_00b876" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:shape="oval">
            <size android:height="21.0dp" android:width="21.0dp" />
            <solid android:color="@color/easemoni_color_white" />
            <stroke android:width="2.0dp" android:color="@color/easemoni_color_b5c1c8" />
        </shape>
    </item>
</selector>
