<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/progress">
        <layer-list>
            <item>
                <rotate android:fromDegrees="0.0" android:toDegrees="315.0" android:pivotX="50.0%" android:pivotY="50.0%">
                    <shape android:shape="oval">
                        <gradient android:startColor="@color/mint" android:endColor="@android:color/transparent" android:useLevel="true" android:angle="45.0" android:centerColor="@color/mint" />
                    </shape>
                </rotate>
            </item>
        </layer-list>
    </item>
</layer-list>
