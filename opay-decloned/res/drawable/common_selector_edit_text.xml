<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/opb_F4F7FA" />
            <corners android:radius="8.0dp" />
            <stroke android:width="1.0dp" android:color="@color/common_color_DC0C48" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/opb_F4F7FA" />
            <corners android:radius="8.0dp" />
            <stroke android:width="1.0dp" android:color="@color/mint" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/opb_F4F7FA" />
            <corners android:radius="8.0dp" />
            <stroke android:width="1.0dp" android:color="@color/mint" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/black_8" />
            <corners android:radius="8.0dp" />
            <stroke android:width="1.0dp" android:color="@color/opb_divider_d8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/opb_F4F7FA" />
            <corners android:radius="8.0dp" />
            <stroke android:width="1.0dp" android:color="@color/opb_F4F7FA" />
        </shape>
    </item>
</selector>
