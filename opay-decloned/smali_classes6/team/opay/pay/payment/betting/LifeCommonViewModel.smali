f\u0001\"\u0006\u0008\u00b0\u0001\u0010\u00b1\u0001R+\u0010\u00b6\u0001\u001a\u0004\u0018\u00010\u00158\u0006@\u0006X\u0086\u000e\u00a2\u0006\u0018\n\u0006\u0008\u00b3\u0001\u0010\u0085\u0001\u001a\u0006\u0008\u00b4\u0001\u0010\u0087\u0001\"\u0006\u0008\u00b5\u0001\u0010\u0089\u0001R+\u0010\u00ba\u0001\u001a\u0004\u0018\u00010\u00158\u0006@\u0006X\u0086\u000e\u00a2\u0006\u0018\n\u0006\u0008\u00b7\u0001\u0010\u0085\u0001\u001a\u0006\u0008\u00b8\u0001\u0010\u0087\u0001\"\u0006\u0008\u00b9\u0001\u0010\u0089\u0001R&\u0010\u00be\u0001\u001a\u00020\t8\u0006@\u0006X\u0086\u000e\u00a2\u0006\u0015\n\u0005\u0008\u00bb\u0001\u0010l\u001a\u0005\u0008\u00bc\u0001\u0010\u0013\"\u0005\u0008\u00bd\u0001\u0010\u007fR \u0010\u00c3\u0001\u001a\u00030\u00bf\u00018FX\u0086\u0084\u0002\u00a2\u0006\u000f\n\u0005\u0008\u00c0\u0001\u0010X\u001a\u0006\u0008\u00c1\u0001\u0010\u00c2\u0001R\u0018\u0010\u00c5\u0001\u001a\u00020\t8\u0002@\u0002X\u0082\u000e\u00a2\u0006\u0007\n\u0005\u0008\u00c4\u0001\u0010lR\"\u0010\u00c8\u0001\u001a\n\u0012\u0006\u0012\u0004\u0018\u0001080a8\u0006\u00a2\u0006\u000e\n\u0005\u0008\u00c6\u0001\u0010c\u001a\u0005\u0008\u00c7\u0001\u0010eR!\u0010\u00ca\u0001\u001a\n\u0012\u0006\u0012\u0004\u0018\u0001080a8\u0006\u00a2\u0006\r\n\u0004\u00085\u0010c\u001a\u0005\u0008\u00c9\u0001\u0010eR\u001f\u0010\u00cc\u0001\u001a\u0008\u0012\u0004\u0012\u00020\t0a8\u0006\u00a2\u0006\r\n\u0004\u00084\u0010c\u001a\u0005\u0008\u00cb\u0001\u0010eR\u001f\u0010\u00ce\u0001\u001a\u0008\u0012\u0004\u0012\u00020\t0a8\u0006\u00a2\u0006\r\n\u0004\u00082\u0010c\u001a\u0005\u0008\u00cd\u0001\u0010eR,\u0010\u00d6\u0001\u001a\u0005\u0018\u00010\u00cf\u00018\u0006@\u0006X\u0086\u000e\u00a2\u0006\u0018\n\u0006\u0008\u00d0\u0001\u0010\u00d1\u0001\u001a\u0006\u0008\u00d2\u0001\u0010\u00d3\u0001\"\u0006\u0008\u00d4\u0001\u0010\u00d5\u0001R!\u0010\u00da\u0001\u001a\t\u0012\u0005\u0012\u00030\u00d7\u00010a8\u0006\u00a2\u0006\u000e\n\u0005\u0008\u00d8\u0001\u0010c\u001a\u0005\u0008\u00d9\u0001\u0010eR(\u0