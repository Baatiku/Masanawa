{
  "name": "@masanawa/web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "brand:check": "node brand-audit.mjs --root src --strict",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "build:cloudflare": "vite build",
    "deploy:cloudflare": "cf deploy --prebuilt",
    "deploy:cloudflare:full": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vinext": "1.3.0",
    "react-server-dom-webpack": "19.3.1",
    "@vinext/cloudflare": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.3",
    "cf": "1.0.0-beta.20"
  }
}
