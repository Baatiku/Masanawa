<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShellTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:colorAccent">#25D366</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="ShellSplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <!-- Android 12+ mandates a system startup window. Leave its artwork
             empty; the WebView already presents the Masanawa loading mark. -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/ShellTheme</item>
    </style>
</resources>
