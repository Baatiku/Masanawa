<?xml version="1.0" encoding="utf-8"?>
<!-- Sessions, private chats and sensitive wallet-related recovery state must
     never be transferred from one Android device to another. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
